{
    "name": "tn3270-server",
    "version": "0.2.0",
    "description": "A 3270 terminal server written in TypeScript.",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "node --watch examples/demo.ts",
        "start:demo": "node examples/demo.ts",
        "test": "node --test \"test/**/*.test.ts\"",
        "typecheck": "tsc -p src && tsc"
    },
    "files": [
        "dist/",
        "tsconfig.json"
    ],
    "engines": {
        "node": ">=22"
    },
    "author": "FireGmr3",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^22.20.5",
        "tsdown": "^0.23.7",
        "typescript": "^7.0.2"
    }
}
